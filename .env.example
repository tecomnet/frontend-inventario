# Copia este archivo a .env y completa los valores.
# En Amplify/Lambda estas mismas claves van como variables de entorno de la función.

# Base de la API de Inventario (a la que el BFF hace de proxy).
API_BASE=https://tecomnet.net/Inventario/api
API_TIMEOUT=30

# Secreto para firmar la cookie de sesión del panel (JWT). En producción DEBE
# ser largo y aleatorio. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TIMEOUT=600

# Modo de autenticación del login:
#   placeholder -> acepta cualquier usuario/contraseña y crea sesión (aún no hay
#                  endpoint de login real; sirve para dejar la interfaz lista).
#   api         -> valida contra AUTH_LOGIN_PATH de la API de Inventario.
AUTH_MODE=placeholder
# Ruta del endpoint de login en la API (se usa solo si AUTH_MODE=api).
AUTH_LOGIN_PATH=/Auth/Login
