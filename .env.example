# Copia este archivo a .env y completa los valores.
# En Amplify/Lambda estas mismas claves van como variables de entorno de la función.

# Base de la API de Inventario (a la que el BFF hace de proxy).
API_BASE=https://tecomnet.net/Inventario/api
API_TIMEOUT=30

# Secreto para firmar la cookie de sesión del panel (JWT). En producción DEBE
# ser largo y aleatorio. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TIMEOUT=600

# Modo de autenticación del login:
#   api         -> (default) valida contra AUTH_LOGIN_PATH de la API de Inventario.
#   placeholder -> acepta cualquier usuario/contraseña. SOLO en desarrollo local:
#                  con NODE_ENV=production (y siempre en el Lambda) se ignora.
AUTH_MODE=api
# Ruta del endpoint de login, relativa a API_BASE (POST { Username, Password }).
AUTH_LOGIN_PATH=/Auth/login
